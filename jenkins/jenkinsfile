pipeline {
    agent any

    stages {
        stage("Fetching") {
            steps {
                git branch: 'main', credentialsId: 'github-id', url: 'https://github.com/Adityavishwakarma31/ci-cd-project.git'
            }
        }
        stage("Building") {
            steps {
                sh "docker build -t adityavishwakarma31/django-todo-app:latest ."
            }
        }
        stage("Testing") {
            steps {
                sh '''
                docker run -d --name testapp -p 8000:8000 adityavishwakarma31/django-todo-app:latest
                sleep 10
                curl "http://localhost:8000"
                docker stop testapp
                docker rm testapp
                '''
            }
        }
        stage("Push") {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                    docker tag adityavishwakarma31/django-todo-app:latest adityavishwakarma31/django-todo-app:${BUILD_NUMBER}
                    echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    docker push adityavishwakarma31/django-todo-app:latest
                    docker push adityavishwakarma31/django-todo-app:${BUILD_NUMBER}
                    docker logout
                    '''
            }
        }
    }
 }
}
