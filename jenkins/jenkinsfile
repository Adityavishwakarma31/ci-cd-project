pipeline {
    agent { label "ec2-agent" }
    stages {
        stage("Fetching") {
            steps {
                git branch: 'main', credentialsId: 'github-id', url: 'https://github.com/Adityavishwakarma31/ci-cd-project.git'
            }
        }
        stage("Building") {
            steps {
                sh "docker build -t django-todo-app:${BUILD_NUMBER} ."
            }
        }
        stage("Testing") {
            steps {
                sh '''
                docker run -d --name testapp -p 8000:8000 django-todo-app:${BUILD_NUMBER}
                sleep 10
                curl "http://localhost:8000"
                docker stop testapp
                docker rm testapp
                '''
            }
        }
        stage("Push") {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                    docker tag django-todo-app:${BUILD_NUMBER} adityavishwakarma31/django-todo-app:${BUILD_NUMBER}
                    echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    docker push adityavishwakarma31/django-todo-app:${BUILD_NUMBER}
                    docker logout
                    '''
              }
            }
          }
        stage("Update Manifests") {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                    rm -rf k8s-manifest
                    git clone https://$GIT_USER:$GIT_TOKEN@github.com/Adityavishwakarma31/k8s-manifest.git
                    cd k8s-manifest
                    sed -i "s|image: adityavishwakarma31/django-todo-app:.*|image: adityavishwakarma31/django-todo-app:${BUILD_NUMBER}|g" k8s-manifest/deployment.yaml

                    git config user.email "jenkins@ci.local"
                    git config user.name "Jenkins CI"
                    git add k8s-manifest/deployment.yaml
                    git commit -m "Update image tag to ${BUILD_NUMBER}"
                    git remote set-url origin https://$GIT_USER:$GIT_TOKEN@github.com/Adityavishwakarma31/ci-cd-project.git
                    git push origin HEAD:main
                    '''
                }
            }
        }
        stage("Deployment") {
             steps {
                 sh '''
                 cd k8s-manifest
                 kubectl apply -f deployment.yaml
                 kubectl apply -f service.yaml
                 '''
             }
         }
      }
   }

